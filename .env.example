# ============================================================
# DATABASE CONFIG
# ============================================================

# Pilih driver: "mysql" atau "sqlite" (fallback otomatis ke sqlite jika mysql gagal)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_NAME=cyberseclab
DB_USER=root
DB_PASS=your_db_password_here

# ============================================================
# APP CONFIG
# ============================================================

# Password akun admin (WAJIB diganti di production!)
CTF_ADMIN_PASSWORD=your_strong_admin_password_here

# Base URL backend
# Lokal : http://localhost:8080
# Render: https://your-app-name.onrender.com
APP_URL=http://localhost:8080

# ============================================================
# SESSION CONFIG (opsional)
# ============================================================
SESSION_NAME=cyberseclab_session
SESSION_LIFETIME=3600
